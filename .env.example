# Agrawal Chamber of Commerce & Industries (ACCI)
# Appwrite Backend Configuration

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=acci_db
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION_ID=users
NEXT_PUBLIC_APPWRITE_MEMBERS_COLLECTION_ID=members
NEXT_PUBLIC_APPWRITE_EVENTS_COLLECTION_ID=events
NEXT_PUBLIC_APPWRITE_NEWS_COLLECTION_ID=news
NEXT_PUBLIC_APPWRITE_JOBS_COLLECTION_ID=jobs
NEXT_PUBLIC_APPWRITE_CONTACT_COLLECTION_ID=contact_submissions
NEXT_PUBLIC_APPWRITE_REVIEWS_COLLECTION_ID=reviews
NEXT_PUBLIC_APPWRITE_STORIES_COLLECTION_ID=impact_stories
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=acci_media

# Optional: Server-side API Key for migration & admin setup script
APPWRITE_API_KEY=

# Automated Email Notification Service
# Default admin inbox for all platform alerts
ADMIN_NOTIFICATION_EMAIL=accijbp@gmail.com

# SMTP Settings for Live Email Delivery (e.g. Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=accijbp@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# SMTP_FROM="ACCI Jabalpur" <accijbp@gmail.com>
